# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# BASE_PATH=/hundo   # set in production to match your reverse proxy path prefix

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hundo

# JWT
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# RAWG API
RAWG_API_KEY=your_rawg_api_key_here
RAWG_BASE_URL=https://api.rawg.io/api

# Email (leave EMAIL_PROVIDER unset or set to 'console' for dev; set to 'resend' in production)
EMAIL_PROVIDER=console
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Hundo <noreply@yourdomain.com>

# Demo Mode (set to 'true' only for the public showcase — returns the verification
# token in the register/resend response so visitors can self-verify in-app without
# a verified email domain; leave 'false' in normal operation)
DEMO_MODE=false
